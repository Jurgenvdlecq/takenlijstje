test('I17: Supabase verification is scoped to the current user request',t=>{const r=fixture(t);begin(r);verify(r);installTask(r,integrationTask());prompt(r,'Nieuwe databasevraag.');installTask(r,integrationTask());assert.throws(()=>call(r,'mcp__supabase__list_migrations'),/deze gebruikersvraag live geverifieerd/);verify(r);assert.doesNotThrow(()=>call(r,'mcp__supabase__list_migrations'));});
