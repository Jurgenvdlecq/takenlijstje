# ---------------------------------------------------------------------------
# Takenlijstje – omgevingsvariabelen
# Kopieer naar .env.local en vul in. Commit .env.local nooit.
# ---------------------------------------------------------------------------

# Supabase (Project Settings → API). Kies bij voorkeur regio EU (Frankfurt).
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
# Alleen server-side: nodig voor achtergrondtaken (herinneringen) en pushmeldingen
SUPABASE_SERVICE_ROLE_KEY=eyJ...

# Publieke URL van de app (voor magic links, uitnodigingen en pushmeldingen)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Web Push (VAPID). Genereer met: npx web-push generate-vapid-keys
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:jij@example.com

# Geheim voor de cron-endpoint /api/cron/tick (lange willekeurige string)
CRON_SECRET=
